generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Operador {
  matricula Int      @id
  nome      String
  valor     Decimal
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  pesagens  Pesagem[]
}

model Corte {
  id        String   @id
  nome      String @unique
  imagem    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pesagens  Pesagem[]
}

model Pesagem {
  id          String     @id @default(uuid())
  peso        Float
  tipoPesagem String     // "inicial" ou "final"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relações
  corte       Corte      @relation(fields: [corteId], references: [id])
  corteId     String
  
  operador    Operador   @relation(fields: [operadorMatricula], references: [matricula])
  operadorMatricula  Int
}

model Especie {
  id        String        @id @default(uuid())
  nome      String

  faixas    EspecieFaixaPeso[]

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([nome])
}

model EspecieFaixaPeso {
  id         String   @id @default(uuid())

  especie    Especie  @relation(fields: [especieId], references: [id])
  especieId  String

  pesoMin    Decimal
  pesoMax    Decimal

  valoresFornecedor FornecedorValorEspecie[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([especieId, pesoMin, pesoMax])
}

model Fornecedor {
  id        String   @id @default(uuid())
  nome      String
  fazenda   String

  valores   FornecedorValorEspecie[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nome, fazenda])
}

model FornecedorValorEspecie {
  id              String   @id @default(uuid())

  fornecedor      Fornecedor      @relation(fields: [fornecedorId], references: [id])
  fornecedorId    String

  faixaPeso       EspecieFaixaPeso @relation(fields: [faixaPesoId], references: [id])
  faixaPesoId     String

  valorKg         Decimal

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([fornecedorId, faixaPesoId])
}


